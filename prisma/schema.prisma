generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String         @id @default(cuid())
  email                String         @unique
  name                 String?
  password             String
  role                 UserRole       @default(CUSTOMER)
  dateOfBirth          DateTime?
  ageVerified          Boolean        @default(false)
  verifiedAt           DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  resetPasswordExpires DateTime?
  resetPasswordToken   String?        @unique
  addresses            Address[]
  cart                 CartItem[]
  orders               Order[]
  reviews              Review[]
  wishlist             WishlistItem[]
}

model Product {
  id                   String                     @id @default(cuid())
  name                 String
  slug                 String                     @unique
  description          String
  price                Float
  compareAtPrice       Float?
  category             Category
  subcategory          String?
  images               String[]
  featured             Boolean                    @default(false)
  thcContent           String?
  cbdContent           String?
  strain               String?
  averageRating        Float?                     @default(0)
  totalReviews         Int                        @default(0)
  totalSales           Int                        @default(0)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  ageRestricted        Boolean                    @default(true)
  discountEndDate      DateTime?
  discountStartDate    DateTime?
  discountType         DiscountType?
  discountValue        Float?
  cartItems            CartItem[]
  frequentlyBoughtWith FrequentlyBoughtTogether[] @relation("ProductA")
  frequentlyBoughtBy   FrequentlyBoughtTogether[] @relation("ProductB")
  orderItems           OrderItem[]
  reviews              Review[]
  storeInventory       StoreInventory[]
  wishlistItems        WishlistItem[]
  bulkPricingRules     BulkPricingRule[]

  @@index([category])
  @@index([featured])
  @@index([ageRestricted])
  @@index([createdAt])
  @@index([category, ageRestricted])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tierLabel String?
  tierPrice Float?
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id                    String          @id @default(cuid())
  userId                String?
  orderNumber           String          @unique
  status                OrderStatus     @default(PENDING)
  total                 Float
  subtotal              Float
  tax                   Float
  shippingCost          Float           @default(0)
  bulkDiscountApplied   Float           @default(0)
  addressId             String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  fulfillmentType       FulfillmentType @default(DELIVERY)
  pickupStoreId         String?
  customerEmail         String
  customerName          String
  customerPhone         String
  deliveryCity          String?
  deliveryCountry       String?         @default("South Africa")
  deliveryState         String?
  deliveryStreet        String?
  deliveryZipCode       String?
  paymentReference      String?
  pudoShipmentId        String?
  pudoTrackingReference String?
  pudoLockerCode        String?
  pudoLockerName        String?
  pudoLockerAddress     String?
  pudoServiceLevelCode  String?
  pudoRate              Float?
  pudoStatus            String?
  pudoLabelUrl          String?
  pudoPincode           String?
  pfPaymentId           String?
  shippingAddress       Address?        @relation(fields: [addressId], references: [id])
  pickupStore           Store?          @relation(fields: [pickupStoreId], references: [id])
  user                  User?           @relation(fields: [userId], references: [id])
  items                 OrderItem[]
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  productId           String
  quantity            Int
  price               Float
  bulkDiscountApplied Float   @default(0)
  createdAt           DateTime @default(now())
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product  @relation(fields: [productId], references: [id])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  fullName  String
  street    String
  city      String
  state     String
  zipCode   String
  country   String   @default("USA")
  phone     String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  title     String?
  comment   String
  verified  Boolean  @default(false)
  helpful   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@index([rating])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model FrequentlyBoughtTogether {
  id         String   @id @default(cuid())
  productAId String
  productBId String
  count      Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  productA   Product  @relation("ProductA", fields: [productAId], references: [id], onDelete: Cascade)
  productB   Product  @relation("ProductB", fields: [productBId], references: [id], onDelete: Cascade)

  @@unique([productAId, productBId])
  @@index([productAId])
  @@index([count])
}

model Store {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  address      String
  city         String
  state        String
  zipCode      String
  country      String           @default("South Africa")
  phone        String
  email        String?
  latitude     Float?
  longitude    Float?
  openingHours Json?
  isActive     Boolean          @default(true)
  allowsPickup Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  orders       Order[]
  inventory    StoreInventory[]

  @@index([isActive])
  @@index([allowsPickup])
}

model StoreInventory {
  id            String   @id @default(cuid())
  storeId       String
  productId     String
  quantity      Int      @default(0)
  lowStockAlert Int      @default(10)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, productId])
  @@index([storeId])
  @@index([productId])
  @@index([quantity])
}

model SiteSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  category    String   @default("general")
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([category])
}

model BulkPricingRule {
  id          String   @id @default(cuid())
  productId   String
  rangeKey    String?  // e.g., "medical", "indoor", "greenhouse", "promo_indoor", "outdoor" — null = product override only
  minQuantity Int      // Minimum quantity to trigger this tier
  maxQuantity Int?     // Maximum quantity for this tier (null = unlimited)
  tierPrice   Float    // Total price for this quantity tier
  isActive    Boolean  @default(true)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, minQuantity, rangeKey])
  @@index([productId])
  @@index([rangeKey])
  @@index([isActive])
}

model PudoLocker {
  id         String   @id
  code       String   @unique
  name       String
  address    String
  latitude   String?
  longitude  String?
  town       String?
  postalCode String?
  isActive   Boolean  @default(true)
  rawData    Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime

  @@index([isActive])
  @@index([town])
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum Category {
  FLOWER
  PRE_ROLLS
  EDIBLES
  CONCENTRATES
  VAPES
  ACCESSORIES
  ROLLING_PAPERS
  BONGS_AND_PIPES
  GRINDERS
  OTHER
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  READY_FOR_PICKUP
  PICKED_UP
  COMPLETED
  REFUNDED
  OUT_FOR_DELIVERY
}

enum FulfillmentType {
  DELIVERY
  PICKUP
  PUDO
}

enum DiscountType {
  PERCENTAGE
  FIXED
}
